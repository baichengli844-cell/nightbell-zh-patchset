+# Gradle 8.13 supports Java up to 23. Android Studio 2026.2.2 ships JBR 25,
+# which the IDE otherwise selects to run Gradle and which Gradle 8.13 refuses.
+# org.gradle.java.home takes precedence over JAVA_HOME for the Gradle daemon,
+# so both command-line builds and IDE syncs land on the same JDK 21.
+# Machine-local path: re-run tools/setup-android-env.ps1 after moving the JDK.
+org.gradle.java.home=D:/Android/jdk-21
+
+# Enabled parallel sync for Gradle 9.4+
+org.gradle.tooling.parallel=true
